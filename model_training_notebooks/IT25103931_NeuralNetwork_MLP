"timestamp":1791052535948,"user_tz":-330,"elapsed":12,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"5af48ede-6dd9-4d1a-8941-99c61754d8e5"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Training Set Shape: (6499, 38)\n","Testing Set Shape:  (1625, 38)\n"]}]},{"cell_type":"markdown","source":["Baseline Model (Default Hyperparameters)"],"metadata":{"id":"3XLgfY-oCrqM"}},{"cell_type":"code","source":["# Train baseline MLP model with default settings\n","base_model = MLPClassifier(random_state=42, max_iter=300)\n","base_model.fit(X_train, y_train)\n","\n","# Evaluate baseline on test data\n","y_pred_base = base_model.predict(X_test)\n","y_prob_base = base_model.predict_proba(X_test)[:, 1]\n","\n","print(\"--- Baseline MLP Results ---\")\n","print(f\"Hidden Layers: {base_model.hidden_layer_sizes}\")\n","print(f\"Accuracy:      {accuracy_score(y_test, y_pred_base) * 100:.2f}%\")\n","print(f\"Recall:        {recall_score(y_test, y_pred_base) * 100:.2f}%\")\n","print(f\"F1-Score:      {f1_score(y_test, y_pred_base) * 100:.2f}%\")\n","print(f\"ROC-AUC:       {roc_auc_score(y_test, y_prob_base):.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RGDJW1TRCsJ8","executionInfo":{"status":"ok","timestamp":1791052537988,"user_tz":-330,"elapsed":2036,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"493ce8fd-b048-4b37-96e4-6d6ce2fb084b"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Baseline MLP Results ---\n","Hidden Layers: (100,)\n","Accuracy:      100.00%\n","Recall:        100.00%\n","F1-Score:      100.00%\n","ROC-AUC:       1.0000\n"]}]},{"cell_type":"markdown","source":["Hyperparameter Tuning via GridSearchCV"],"metadata":{"id":"DYlbEqt9Cu8t"}},{"cell_type":"code","source":["# Parameter grid testing hidden layer architectures, activation functions, and regularization\n","param_grid = {\n","    'hidden_layer_sizes': [(50,), (100,), (50, 25)],\n","    'activation': ['relu', 'tanh'],\n","    'alpha': [0.0001, 0.01]\n","}\n","\n","# Stratified 5-Fold Cross Validation\n","cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n","\n","# Run GridSearchCV with n_jobs=1 to ensure stable execution\n","grid_search = GridSearchCV(\n","    estimator=MLPClassifier(random_state=42, max_iter=300),\n","    param_grid=param_grid,\n","    scoring='f1',\n","    cv=cv,\n","    n_jobs=1,\n","    verbose=1\n",")\n","\n","grid_search.fit(X_train, y_train)\n","\n","print(\"\\nBest Hyperparameters Found:\")\n","print(grid_search.best_params_)\n","print(f\"Best 5-Fold CV F1-Score: {grid_search.best_score_ * 100:.2f}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JVyO_GCiCvdU","executionInfo":{"status":"ok","timestamp":1791052773694,"user_tz":-330,"elapsed":235702,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"de5c35d1-3816-440b-c71c-fdf519d0a6e0"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Fitting 5 folds for each of 12 candidates, totalling 60 fits\n","\n","Best Hyperparameters Found:\n","{'activation': 'relu', 'alpha': 0.0001, 'hidden_layer_sizes': (50, 25)}\n","Best 5-Fold CV F1-Score: 99.97%\n"]}]},{"cell_type":"markdown","source":["Final Tuned Model Evaluation and Comparison Table"],"metadata":{"id":"CgiluqaACxxg"}},{"cell_type":"code","source":["# Best optimized model from GridSearch\n","best_model = grid_search.best_estimator_\n","\n","# Predict on test set\n","y_pred_opt = best_model.predict(X_test)\n","y_prob_opt = best_model.predict_proba(X_test)[:, 1]\n","\n","# Detailed Classification Report\n","print(\"--- Final Tuned Model Classification Report ---\")\n","print(classification_report(y_test, y_pred_opt, target_names=['Edible (0)', 'Poisonous (1)']))\n","\n","# Comparison Table: Baseline vs Tuned\n","comparison_df = pd.DataFrame({\n","    'Metric': ['Hidden Layers', 'A