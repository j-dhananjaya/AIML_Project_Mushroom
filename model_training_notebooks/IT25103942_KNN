SSE4Tqj","executionInfo":{"status":"ok","timestamp":1791868412852,"user_tz":-330,"elapsed":2112,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"a7bcf935-c69e-4d24-96bc-60946243f21d"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Libraries imported successfully!\n"]}]},{"cell_type":"markdown","source":["Load Final Processed Dataset"],"metadata":{"id":"G2WEk4KD4Vcn"}},{"cell_type":"code","source":["# Load the final preprocessed dataset from Review 1\n","df = pd.read_csv(\"final_processed_dataset.csv\")\n","\n","# Separate features (X) and target (y)\n","X = df.drop(columns=['class'])\n","y = df['class']\n","\n","print(\"Data Loaded Successfully!\")\n","print(f\"Features Shape: {X.shape} (Target: 'class', Predictors: {X.shape[1]} PCs)\")\n","print(\"Class Distribution:\\n\", y.value_counts())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"X10doWJR4W9D","executionInfo":{"status":"ok","timestamp":1791868413787,"user_tz":-330,"elapsed":918,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"0355ddc3-99de-4ed7-cd3c-fac2dfd02bce"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Data Loaded Successfully!\n","Features Shape: (8124, 38) (Target: 'class', Predictors: 38 PCs)\n","Class Distribution:\n"," class\n","0    4208\n","1    3916\n","Name: count, dtype: int64\n"]}]},{"cell_type":"markdown","source":["Stratified train-test split (80/20)"],"metadata":{"id":"OYj7wrpu4ZOQ"}},{"cell_type":"code","source":["# Stratified 80/20 train-test split to preserve class proportions\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X, y, test_size=0.20, random_state=42, stratify=y\n",")\n","\n","print(f\"Training Set Shape: {X_train.shape}\")\n","print(f\"Testing Set Shape:  {X_test.shape}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"W9XWSsH-4Z36","executionInfo":{"status":"ok","timestamp":1791868413792,"user_tz":-330,"elapsed":52,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"6cff23ba-d075-471f-a6e8-44438905d035"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Training Set Shape: (6499, 38)\n","Testing Set Shape:  (1625, 38)\n"]}]},{"cell_type":"markdown","source":["Baseline Model (Default Hyperparameters)"],"metadata":{"id":"IMJnKPs84cEE"}},{"cell_type":"code","source":["# Train baseline KNN model with default settings (k=5)\n","base_model = KNeighborsClassifier()\n","base_model.fit(X_train, y_train)\n","\n","# Evaluate baseline on test data\n","y_pred_base = base_model.predict(X_test)\n","y_prob_base = base_model.predict_proba(X_test)[:, 1]\n","\n","print(\"--- Baseline KNN Results ---\")\n","print(f\"Accuracy:  {accuracy_score(y_test, y_pred_base) * 100:.2f}%\")\n","print(f\"Recall:    {recall_score(y_test, y_pred_base) * 100:.2f}%\")\n","print(f\"F1-Score:  {f1_score(y_test, y_pred_base) * 100:.2f}%\")\n","print(f\"ROC-AUC:   {roc_auc_score(y_test, y_prob_base):.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8gXz1-dS4cqF","executionInfo":{"status":"ok","timestamp":1791868413973,"user_tz":-330,"elapsed":202,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"2fd9a54f-e44a-42e9-ad17-94a4002be64e"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Baseline KNN Results ---\n","Accuracy:  100.00%\n","Recall:    100.00%\n","F1-Score:  100.00%\n","ROC-AUC:   1.0000\n"]}]},{"cell_type":"markdown","source":["Hyperparameter Tuning via GridSearchCV"],"metadata":{"id":"SO49-eR94fFe"}},{"cell_type":"code","source":["# Parameter grid exploring neighbor counts, distance weights, and metrics\n","param_grid = {\n","    'n_neighbors': [3, 5, 7, 9, 11, 15],\n","    'weights': ['uniform', 'distance'],\n","    'metric': ['euclidean', 'manhattan']\n","}\n","\n","# Stratified 5-Fold Cross Validation\n","cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n","\n","# Run GridSearchCV optimizing F1-score\n","grid_search = GridSearchCV(\n","    estimator=KNeighborsClassifier(),\n","    param_grid=param_grid,\n","    scoring='f1',\n","    cv=cv,\n","    n_jobs=-1,\n","    verbose=1\n",")\n","\n","grid_search.fit(X_train, y_train)\n","\n","print(\"\\nBest Hyperparameters Found:\")\n","print(grid_search.best_params_)\n","print(f\"Best 5-Fold CV F1-Score: {grid_search.best_score_ * 100:.2f}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pBi5vRpG4fl7","executionInfo":{"status":"ok","timestamp":1791868446891,"user_tz":-330,"elapsed":32918,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"2bc62bdb-324f-4f40-ffb4-65ca783e786f"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Fitting 5 folds for each of 24 candidates, totalling 120 fits\n","\n","Best Hyperparameters Found:\n","{'metric': 'euclidean', 'n_neighbors': 3, 'weights': 'distance'}\n","Best 5-Fold CV F1-Score: 99.98%\n"]}]},{"cell_type":"markdown","source":["Final Tuned Model Evaluation and Comparison Table"],"metadata":{"id":"4OIg5Ldk4hyp"}},{"cell_type":"code","source":["# Best optimized model from GridSearch\n","best_model = grid_search.best_estimator_\n","\n","# Predict on test set\n","y_pred_opt = best_model.predict(X_test)\n","y_prob_opt = best_model.predict_proba(X_test)[:, 1]\n","\n","# Detailed Classification Report\n","print(\"--- Final Tuned Model Classification Report ---\")\n","print(classification_report(y_test, y_pred_opt, target_names=['Edible (0)', 'Poisonous (1)']))\n","\n","# Comparison Table: Baseline vs Tuned\n","comparison_df = pd.DataFrame({\n","    'Metric': ['Neighbors (K)', 'Accuracy', 'Precision', 'Recall', 'F1-Score', 'ROC-AUC'],\n","    'Baseline Model': [\n","        str(base_model.n_neighbors),\n","        f\"{accuracy_score(y_test, y_pred_base)*100:.2f}%\",\n","        f\"{precision_score(y_test, y_pred_base)*100:.2f}%\",\n","        f\"{recall_score(y_test, y_pred_base)*100:.2f}%\",\n","        f\"{f1_score(y_test, y_pred_base)*100:.2f}%\",\n","        f\"{roc_auc_score(y_test, y_prob_base):.4f}\"\n","    ],\n","    'Tuned Model': [\n","        str(best_model.n_neighbors),\n","        f\"{accuracy_score(y_test, y_pred_opt)*100:.2f}%\",\n","        f\"{precision_score(y_test, y_pred_opt)*100:.2f}%\",\n","        f\"{recall_score(y_test, y_pred_opt)*100:.2f}%\",\n","        f\"{f1_score(y_test, y_pred_opt)*100:.2f}%\",\n","        f\"{roc_auc_score(y_test, y_prob_opt):.4f}\"\n","    ]\n","})\n","\n","print(\"\\n--- Model Performance Comparison Table ---\")\n","print(comparison_df.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Z3AxdZmp4iXW","executionInfo":{"status":"ok","timestamp":1791868447117,"user_tz":-330,"elapsed":229,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"9f30e123-90e4-439f-dd1a-650e1d233621"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Final Tuned Model Classification Report ---\n","               precision    recall  f1-score   support\n","\n","   Edible (0)       1.00      1.00      1.00       842\n","Poisonous (1)       1.00      1.00      1.00       783\n","\n","     accuracy                           1.00      1625\n","    macro avg       1.00      1.00      1.00      1625\n"," weighted avg       1.00      1.00      1.00      1625\n","\n","\n","--- Model Performance Comparison Table ---\n","       Metric Baseline Model Tuned Model\n","Neighbors (K)              5           3\n","     Accuracy        100.00%     100.00%\n","    Precision        100.00%     100.00%\n","       Recall        100.00%     100.00%\n","     F1-Score        100.00%     100.00%\n","      ROC-AUC         1.0000      1.0000\n"]}]},{"cell_type":"markdown","source":["Visualization 1: Confusion Matrix"],"metadata":{"id":"xybu-lJH