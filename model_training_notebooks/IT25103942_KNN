=0.3)\n","plt.tight_layout()\n","plt.savefig('knn_roc_curve.png', dpi=300)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":507},"id":"ZWz1YjIs4ol9","executionInfo":{"status":"ok","timestamp":1791868449552,"user_tz":-330,"elapsed":1167,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"e3730179-2d71-459c-e346-684416b3ffe3"},"execution_count":9,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 700x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["Visualization 3: K-Value vs Cross-Validation Score"],"metadata":{"id":"FJzMMDDA4qtF"}},{"cell_type":"code","source":["# Evaluate performance across different values of K\n","k_range = list(range(3, 21, 2))\n","k_scores = []\n","\n","cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n","\n","for k in k_range:\n","    knn = KNeighborsClassifier(n_neighbors=k, weights=best_model.weights, metric=best_model.metric)\n","    scores = GridSearchCV(knn, param_grid={}, cv=cv, scoring='f1', n_jobs=-1).fit(X_train, y_train)\n","    k_scores.append(scores.best_score_ * 100)\n","\n","plt.figure(figsize=(8, 5))\n","plt.plot(k_range, k_scores, marker='o', linestyle='-', color='indigo', lw=2)\n","plt.title('K-Value vs Cross-Validation F1-Score', fontsize=12, fontweight='bold')\n","plt.xlabel('Number of Neighbors (K)')\n","plt.ylabel('CV F1-Score (%)')\n","plt.xticks(k_range)\n","plt.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.savefig('knn_k_value_curve.png', dpi=300)\n","plt.show()\n","\n","print(\"All plots saved directly to working directory!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":524},"id":"kc6HqgiB4rKM","executionInfo":{"status":"ok","timestamp":1791868453606,"user_tz":-330,"elapsed":4052,"user":{"displayName":"Janith Dhananjaya","userId":"02741481183955247653"}},"outputId":"835edaf9-b30b-4e59-c47f-70ecf700ff60"},"execution_count":10,"outputs":[{"